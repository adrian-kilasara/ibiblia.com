# ─────────────────────────────────────────────────────────────
# Production environment variables (set these in each host's dashboard)
# ─────────────────────────────────────────────────────────────

# ===== API service (Render / Koyeb / Fly) =====
# Neon Postgres connection string (must include sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/ibiblia?sslmode=require"
# Long random secret for admin JWTs
JWT_SECRET="generate-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Your public site URL (used for CORS-friendly links / donation redirects)
WEB_URL="https://your-site.vercel.app"
# PORT is injected automatically by the host — do NOT set it.

# --- Optional: image uploads (Cloudflare R2, free 10GB). Leave unset to disable uploads. ---
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="ibiblia-media"
# S3_ACCESS_KEY_ID="<r2-access-key>"
# S3_SECRET_ACCESS_KEY="<r2-secret-key>"
# S3_PUBLIC_URL="https://<your-public-r2-domain>"   # the bucket's public r2.dev URL or custom domain

# --- Optional: donations / email (leave unset to disable) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# PAYSTACK_SECRET_KEY=""
# RESEND_API_KEY=""

# ===== Web site + Admin (Vercel) =====
# Point both Vercel projects at your deployed API:
NEXT_PUBLIC_API_URL="https://ibiblia-api.onrender.com"
