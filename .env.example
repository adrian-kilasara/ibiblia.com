# ─────────────────────────────────────────────────────────────
# iBiblia — environment variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# Database (Postgres) — matches infra/docker-compose.yml for local dev.
# High host ports are used because this machine already runs other stacks on the defaults.
DATABASE_URL="postgresql://ibiblia:ibiblia@localhost:55432/ibiblia?schema=public"

# Redis (cache/queues)
REDIS_URL="redis://localhost:63817"

# API
API_PORT=4400
API_URL="http://localhost:4400"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Public site / admin → API
NEXT_PUBLIC_API_URL="http://localhost:4400"

# Public site origin (donation success/cancel redirects)
WEB_URL="http://localhost:3200"

# Object storage (S3-compatible; MinIO locally on host ports 9002/9003)
S3_ENDPOINT="http://localhost:9002"
S3_REGION="us-east-1"
S3_BUCKET="ibiblia-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9002/ibiblia-media"

# Donations — Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Donations — Paystack (African gateway; default)
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."

# Transactional email (receipts) — Resend
RESEND_API_KEY="re_..."
MAIL_FROM="iBiblia <no-reply@ibiblia.com>"
