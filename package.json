{
  "name": "ibiblia",
  "version": "0.1.0",
  "private": true,
  "description": "iBiblia — Bible translation, publishing, and distribution. Marketing site + custom CMS.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:migrate": "pnpm --filter @ibiblia/api db:migrate",
    "db:seed": "pnpm --filter @ibiblia/api db:seed",
    "db:studio": "pnpm --filter @ibiblia/api db:studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  }
}
